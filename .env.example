# Copy this file to .env.local and fill in your Supabase project's values
# (Dashboard -> Project Settings -> API). Without them the app runs in
# in-memory mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Real payments (Stripe) ---------------------------------------------
# These are set in Vercel's Environment Variables, NOT here, and power the
# serverless functions in /api. See docs/PAYMENTS.md for the full guide.
# They are server-only secrets and must never appear in the front-end bundle.
#   STRIPE_SECRET_KEY=sk_...              (Stripe -> Developers -> API keys)
#   SUPABASE_SERVICE_ROLE_KEY=...         (Supabase -> Settings -> API)
#   SUPABASE_URL=                         (optional; defaults to your project)
